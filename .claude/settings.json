{
  "model": "opus",
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Bash(*.env*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *HEAD:main*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.*",
        "**/.env",
        "**/.env.*"
      ],
      "denyWrite": [
        "./.env",
        "./.env.*",
        "**/.env",
        "**/.env.*"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "UV_CACHE_DIR": "/tmp/claude/uv-cache",
    "UV_TOOL_DIR": "/tmp/claude/uv-tools"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/PLAN.md\"; if [ -f \"$f\" ]; then echo '# Restored from PLAN.md (orchestrate skill state). Check the branch in its header matches `git branch --show-current`, then continue from its Next section.'; echo; cat \"$f\"; fi"
          }
        ]
      }
    ]
  }
}
